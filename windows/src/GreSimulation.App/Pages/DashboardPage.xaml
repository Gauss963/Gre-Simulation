<?xml version="1.0" encoding="utf-8"?>
<!-- Port of DashboardView.swift: hero, latest result, session cards, format overview, accuracy notice. -->
<Page
    x:Class="GreSimulation.App.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <!-- Shown while the question bank loads at startup. -->
        <StackPanel x:Name="LoadingPanel" Spacing="14" HorizontalAlignment="Center" VerticalAlignment="Center">
            <ProgressRing IsActive="True" Width="48" Height="48" />
            <TextBlock Text="Loading the question bank…" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       HorizontalAlignment="Center" />
        </StackPanel>

        <InfoBar x:Name="LoadErrorBar" Severity="Error" IsClosable="False" IsOpen="False"
                 Title="The question bank could not be loaded" Margin="36" VerticalAlignment="Top" />

        <ScrollViewer x:Name="ContentScroller" Visibility="Collapsed">
            <StackPanel Spacing="26" Margin="30" MaxWidth="1050" HorizontalAlignment="Stretch">
                <!-- Hero -->
                <Border Style="{StaticResource CardStyle}">
                    <Grid ColumnSpacing="28">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="12" VerticalAlignment="Center">
                            <TextBlock x:Name="HeroTitle" FontSize="34" FontWeight="Bold" TextWrapping="Wrap"
                                       Foreground="{ThemeResource NavyBrush}" AutomationProperties.HeadingLevel="Level1" />
                            <TextBlock x:Name="HeroText" FontSize="18" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8F1;" FontSize="14" Foreground="{ThemeResource TealBrush}" />
                                <TextBlock x:Name="BankSummaryText" FontWeight="SemiBold" Foreground="{ThemeResource TealBrush}" />
                            </StackPanel>
                            <Button x:Name="StartFullButton" Style="{StaticResource AccentButtonStyle}" Padding="22,10"
                                    FontWeight="SemiBold" Margin="0,4,0,0" Click="OnStartFullClick" AccessKey="S" />
                        </StackPanel>
                        <Grid Grid.Column="1" Width="185" Height="185" VerticalAlignment="Center"
                              AutomationProperties.AccessibilityView="Raw">
                            <Ellipse Fill="{ThemeResource BrightBlueBrush}" Opacity="0.10" />
                            <Ellipse Width="163" Height="163" Stroke="{ThemeResource BrightBlueBrush}" StrokeThickness="18" Opacity="0.20" />
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="2">
                                <TextBlock x:Name="HeroClock" FontFamily="Consolas" FontSize="36" FontWeight="Bold"
                                           Foreground="{ThemeResource BlueBrush}" HorizontalAlignment="Center" />
                                <TextBlock x:Name="HeroClockCaption" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Latest result (only when there is history) -->
                <Border x:Name="LatestCard" Style="{StaticResource CardStyle}" Visibility="Collapsed">
                    <StackPanel x:Name="LatestPanel" Orientation="Horizontal" Spacing="28">
                        <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock x:Name="LatestTitle" FontSize="12" FontWeight="Bold" Foreground="{ThemeResource TealBrush}" />
                            <TextBlock x:Name="LatestDate" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        </StackPanel>
                        <Rectangle Width="1" Height="44" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    </StackPanel>
                </Border>

                <!-- Session cards -->
                <StackPanel Spacing="14">
                    <TextBlock x:Name="ChooseTitle" Style="{StaticResource SubtitleTextBlockStyle}" AutomationProperties.HeadingLevel="Level2" />
                    <Grid x:Name="SessionGrid" ColumnSpacing="16" RowSpacing="16" SizeChanged="OnSessionGridSizeChanged" />
                </StackPanel>

                <!-- Format overview -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="16">
                        <TextBlock x:Name="FormatTitle" Style="{StaticResource SubtitleTextBlockStyle}" AutomationProperties.HeadingLevel="Level2" />
                        <Grid x:Name="FormatGrid" ColumnSpacing="24" RowSpacing="11" />
                    </StackPanel>
                </Border>

                <!-- Accuracy notice -->
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE946;" FontSize="14" Foreground="{ThemeResource BlueBrush}" VerticalAlignment="Top" Margin="0,2,0,0" />
                    <TextBlock x:Name="AccuracyNotice" Grid.Column="1" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
