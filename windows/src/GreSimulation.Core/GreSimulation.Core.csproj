<Project Sdk="Microsoft.NET.Sdk">
  <!-- Platform-neutral logic: models, question bank, exam sessions, scoring, and saved progress.
       It has no Windows dependency, so its tests also run on macOS. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>GreSimulation.Core</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- Content that the Mac app writes as Swift literals (VerbalQuestionBank.swift,
         QuantitativeQuestionBank.swift, QuestionBank.writingQuestion, VocabularyBank.curatedWords),
         exported verbatim with the Swift encoder. -->
    <EmbeddedResource Include="Data\SwiftLiteralQuestions.json" LogicalName="SwiftLiteralQuestions.json" />
    <EmbeddedResource Include="Data\CuratedVocabulary.json" LogicalName="CuratedVocabulary.json" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="GreSimulation.Core.Tests" />
  </ItemGroup>
</Project>
