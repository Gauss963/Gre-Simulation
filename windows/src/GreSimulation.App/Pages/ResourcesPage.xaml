<?xml version="1.0" encoding="utf-8"?>
<!-- Port of ResourcesView (LibraryViews.swift). -->
<Page
    x:Class="GreSimulation.App.Pages.ResourcesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GreSimulation.App.Pages"
    xmlns:controls="using:GreSimulation.App.Controls">

    <Page.Resources>
        <DataTemplate x:Key="BankMetricTemplate" x:DataType="local:ResourceMetric">
            <Border Padding="12" CornerRadius="8" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                <StackPanel Spacing="3">
                    <TextBlock Text="{x:Bind Title}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{x:Bind Value}" FontSize="28" FontWeight="Bold" Foreground="{ThemeResource BlueBrush}" />
                    <TextBlock Text="{x:Bind Detail}" FontSize="11" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="SourceRowTemplate" x:DataType="local:SourceSummaryRow">
            <Grid ColumnSpacing="12" Padding="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind Title}" FontSize="13" TextWrapping="Wrap" />
                <TextBlock Grid.Column="1" Text="{x:Bind Count}" FontSize="13"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="LinkTemplate" x:DataType="local:ResourceLinkRow">
            <StackPanel Spacing="8">
                <HyperlinkButton HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="0,5"
                                 Tag="{x:Bind Url}" Click="OnLinkClick"
                                 AutomationProperties.Name="{x:Bind Title}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="3">
                            <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="{x:Bind Detail}" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <FontIcon Grid.Column="1" Glyph="&#xE8A7;" FontSize="16" VerticalAlignment="Center"
                                  Foreground="{ThemeResource BlueBrush}" />
                    </Grid>
                </HyperlinkButton>
                <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}"
                           Visibility="{x:Bind DividerVisibility}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="SectionTemplate" x:DataType="local:ResourceSectionCard">
            <Border Style="{StaticResource CardStyle}" CornerRadius="12">
                <StackPanel Spacing="13">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="{x:Bind Glyph}" FontSize="20" Foreground="{ThemeResource NavyBrush}" />
                        <TextBlock Text="{x:Bind Title}" FontSize="20" FontWeight="Bold" Foreground="{ThemeResource NavyBrush}" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{x:Bind Links}" ItemTemplate="{StaticResource LinkTemplate}" IsTabStop="False" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel Style="{StaticResource PageContentStyle}" MaxWidth="950" Spacing="20">
            <StackPanel Spacing="6">
                <TextBlock x:Name="HeadingText" FontSize="30" FontWeight="Bold" TextWrapping="Wrap"
                           Foreground="{ThemeResource NavyBrush}" />
                <TextBlock x:Name="SubheadingText" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- Offline content bank -->
            <Border Style="{StaticResource CardStyle}" CornerRadius="12">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xEDA2;" FontSize="20" Foreground="{ThemeResource NavyBrush}" />
                        <TextBlock x:Name="BankTitle" FontSize="20" FontWeight="Bold" Foreground="{ThemeResource NavyBrush}" />
                    </StackPanel>
                    <ProgressRing x:Name="LoadingRing" IsActive="True" HorizontalAlignment="Left" Width="28" Height="28" />
                    <ItemsControl x:Name="BankMetrics" ItemTemplate="{StaticResource BankMetricTemplate}" IsTabStop="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <controls:EqualColumnsPanel Spacing="14" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <ItemsControl x:Name="SourceRows" ItemTemplate="{StaticResource SourceRowTemplate}" IsTabStop="False" />
                    <TextBlock x:Name="BankFootnote" FontSize="12" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>

            <ItemsControl x:Name="Sections" ItemTemplate="{StaticResource SectionTemplate}" IsTabStop="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="20" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <!-- Content and score transparency -->
            <Border Style="{StaticResource CardStyle}" CornerRadius="12">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xEA18;" FontSize="16" Foreground="{ThemeResource NavyBrush}" />
                        <TextBlock x:Name="TransparencyTitle" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource NavyBrush}" />
                    </StackPanel>
                    <TextBlock x:Name="TransparencyText" FontSize="13" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="TrademarkText" FontSize="12" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
