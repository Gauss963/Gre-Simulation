<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="GreSimulation.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="GRE Simulation">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom title bar drawn over Mica (the window extends into the title bar). -->
        <Grid x:Name="AppTitleBar" Height="40" Padding="16,0,0,0">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Image Source="ms-appx:///Assets/AppIcon-32.png" Width="16" Height="16" />
                <TextBlock Text="GRE Simulation" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <NavigationView x:Name="Nav" Grid.Row="1"
                        PaneDisplayMode="Left" OpenPaneLength="260"
                        IsBackButtonVisible="Collapsed" IsSettingsVisible="False"
                        IsPaneToggleButtonVisible="True"
                        SelectionChanged="OnNavigationSelectionChanged">
            <NavigationView.PaneHeader>
                <StackPanel Orientation="Horizontal" Spacing="11" Margin="4,4,0,8">
                    <Border Width="40" Height="40" CornerRadius="9" Background="{ThemeResource BrandActionBrush}">
                        <TextBlock Text="G" FontFamily="Georgia" FontSize="22" FontWeight="Bold"
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="GRE Simulator" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock x:Name="BrandSubtitle" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </NavigationView.PaneHeader>
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Practice Tests" Tag="dashboard">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE70F;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Vocabulary" Tag="vocabulary">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE82D;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Score History" Tag="history">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE9D2;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Official Resources" Tag="resources">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE73E;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.PaneFooter>
                <TextBlock Text="Independent GRE® practice simulator" Margin="16,8,16,14" TextWrapping="Wrap"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </NavigationView.PaneFooter>
            <Frame x:Name="ContentFrame" />
        </NavigationView>

        <!-- Practice tests take over the whole window, like the Mac app. -->
        <ContentControl x:Name="ExamHost" Grid.Row="1" Visibility="Collapsed"
                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
    </Grid>
</Window>
