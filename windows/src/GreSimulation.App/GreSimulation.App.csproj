<Project Sdk="Microsoft.NET.Sdk">
  <!-- WinUI 3 (Windows App SDK) desktop app. Unpackaged and self-contained: users unzip and run it. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>GreSimulation.App</RootNamespace>
    <AssemblyName>GreSimulation</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.6.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GreSimulation.Core\GreSimulation.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\AppIcon.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\AppIcon-32.png" CopyToOutputDirectory="PreserveNewest" />
    <!-- The Mac app's resources, used in place so the question bank and audio never drift apart. -->
    <Content Include="$(MacResourcesDir)**\*" LinkBase="Resources" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
