<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!-- Lets the tests run on a machine that only has a newer .NET runtime (for example on a Mac). -->
    <RollForward>Major</RollForward>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\GreSimulation.Core\GreSimulation.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <!-- Values produced by the Mac app's own Swift code, for parity checks. -->
    <None Include="Reference\SwiftReference.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
