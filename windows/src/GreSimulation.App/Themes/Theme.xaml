<?xml version="1.0" encoding="utf-8"?>
<!-- Brand colors and shared styles, matching the Mac app's GRETheme. -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="BrandHeaderBrush" Color="#0E2B45" />
            <SolidColorBrush x:Key="BrandActionBrush" Color="#0D528A" />
            <SolidColorBrush x:Key="NavyBrush" Color="#0E2B45" />
            <SolidColorBrush x:Key="BlueBrush" Color="#0D528A" />
            <SolidColorBrush x:Key="BrightBlueBrush" Color="#0D73B8" />
            <SolidColorBrush x:Key="TealBrush" Color="#14858F" />
            <SolidColorBrush x:Key="WarningBrush" Color="#C75714" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="BrandHeaderBrush" Color="#0E2B45" />
            <SolidColorBrush x:Key="BrandActionBrush" Color="#0D528A" />
            <SolidColorBrush x:Key="NavyBrush" Color="#A8D6F5" />
            <SolidColorBrush x:Key="BlueBrush" Color="#59B2F0" />
            <SolidColorBrush x:Key="BrightBlueBrush" Color="#5CC7FA" />
            <SolidColorBrush x:Key="TealBrush" Color="#61D1C9" />
            <SolidColorBrush x:Key="WarningBrush" Color="#FFA35C" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Accent controls (AccentButtonStyle, ProgressBar, CheckBox, …) use the brand action color. -->
    <Color x:Key="SystemAccentColor">#0D528A</Color>
    <Color x:Key="SystemAccentColorLight1">#2F72A8</Color>
    <Color x:Key="SystemAccentColorLight2">#5B95C4</Color>
    <Color x:Key="SystemAccentColorLight3">#93BCDD</Color>
    <Color x:Key="SystemAccentColorDark1">#0A446F</Color>
    <Color x:Key="SystemAccentColorDark2">#073556</Color>
    <Color x:Key="SystemAccentColorDark3">#05273F</Color>

    <!-- The Mac app's card: rounded surface with a hairline border. -->
    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Padding" Value="20" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- Page content column with the Mac app's margins. -->
    <Style x:Key="PageContentStyle" TargetType="StackPanel">
        <Setter Property="Margin" Value="36,28,36,36" />
        <Setter Property="Spacing" Value="18" />
        <Setter Property="MaxWidth" Value="1180" />
    </Style>
</ResourceDictionary>
