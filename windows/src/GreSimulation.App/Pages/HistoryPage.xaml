<?xml version="1.0" encoding="utf-8"?>
<!-- Port of HistoryView (LibraryViews.swift). -->
<Page
    x:Class="GreSimulation.App.Pages.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GreSimulation.App.Pages"
    xmlns:controls="using:GreSimulation.App.Controls">

    <Page.Resources>
        <!-- A score tile (the Mac's resultMetric). -->
        <DataTemplate x:Key="MetricTemplate" x:DataType="local:HistoryMetric">
            <Border Padding="14" CornerRadius="8" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                <StackPanel Spacing="3">
                    <TextBlock Text="{x:Bind Title}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{x:Bind Value}" FontSize="28" FontWeight="Bold" Foreground="{ThemeResource NavyBrush}" />
                    <TextBlock Text="{x:Bind Subtitle}" FontSize="11" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- A section chip, e.g. "Verbal 2  11/15  · Hard". -->
        <DataTemplate x:Key="ChipTemplate" x:DataType="local:HistoryChip">
            <Border Padding="10,6" CornerRadius="14" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                <TextBlock FontSize="12">
                    <Run Text="{x:Bind Name}" FontWeight="SemiBold" /><Run Text="{x:Bind Detail}" />
                </TextBlock>
            </Border>
        </DataTemplate>

        <!-- One saved result (the Mac's historyCard). -->
        <DataTemplate x:Key="HistoryCardTemplate" x:DataType="local:HistoryCardItem">
            <Border Style="{StaticResource CardStyle}" CornerRadius="12">
                <StackPanel Spacing="16">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="3">
                            <TextBlock Text="{x:Bind Title}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind DateText}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="8" HorizontalAlignment="Right">
                            <TextBlock Text="{x:Bind DurationText}" FontSize="14" HorizontalAlignment="Right"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Button Content="Review answers" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Right"
                                    Visibility="{x:Bind ReviewVisibility}" Click="OnReviewAnswersClick" />
                            <TextBlock Text="Score-only record" FontSize="11" HorizontalAlignment="Right"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       Visibility="{x:Bind ScoreOnlyVisibility}" />
                        </StackPanel>
                    </Grid>

                    <ItemsControl ItemsSource="{x:Bind Metrics}" ItemTemplate="{StaticResource MetricTemplate}" IsTabStop="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <controls:EqualColumnsPanel Spacing="12" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}"
                               Visibility="{x:Bind SectionsVisibility}" />
                    <ItemsControl ItemsSource="{x:Bind Chips}" ItemTemplate="{StaticResource ChipTemplate}" IsTabStop="False"
                                  Visibility="{x:Bind SectionsVisibility}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <controls:WrapPanel HorizontalSpacing="12" VerticalSpacing="8" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <ScrollViewer x:Name="PageScroller">
            <StackPanel Style="{StaticResource PageContentStyle}" MaxWidth="950" Spacing="20">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="6">
                        <TextBlock x:Name="HeadingText" FontSize="30" FontWeight="Bold" TextWrapping="Wrap"
                                   Foreground="{ThemeResource NavyBrush}" />
                        <TextBlock x:Name="SubheadingText" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <Button x:Name="ClearButton" Grid.Column="1" VerticalAlignment="Center" Visibility="Collapsed"
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}" Click="OnClearClick">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE74D;" FontSize="14" />
                            <TextBlock x:Name="ClearButtonText" />
                        </StackPanel>
                    </Button>
                </Grid>

                <ProgressRing x:Name="LoadingRing" IsActive="True" HorizontalAlignment="Left" Width="32" Height="32" />

                <!-- No completed tests -->
                <Border x:Name="EmptyState" Style="{StaticResource CardStyle}" CornerRadius="12" MinHeight="420" Visibility="Collapsed">
                    <StackPanel Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="480">
                        <FontIcon Glyph="&#xE9D2;" FontSize="44" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="EmptyTitle" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock x:Name="EmptyMessage" TextAlignment="Center" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <ItemsRepeater x:Name="ResultsList" ItemTemplate="{StaticResource HistoryCardTemplate}">
                    <ItemsRepeater.Layout>
                        <StackLayout Orientation="Vertical" Spacing="20" />
                    </ItemsRepeater.Layout>
                </ItemsRepeater>
            </StackPanel>
        </ScrollViewer>

        <!-- A saved report covers the page, like the Mac's overlay. -->
        <Grid x:Name="ReportOverlay" Visibility="Collapsed" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
            <ContentControl x:Name="ReportPresenter" IsTabStop="False"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
        </Grid>
    </Grid>
</Page>
