<?xml version="1.0" encoding="utf-8"?>
<!-- Port of ScoreReportView.swift: score cards, writing feedback, section performance, answer review, methodology. -->
<UserControl
    x:Class="GreSimulation.App.Controls.ScoreReportView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Navy report header with the Done / Save & Close button. -->
        <Grid Height="58" Padding="20,0" ColumnSpacing="10" Background="{ThemeResource BrandHeaderBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="GRE" FontFamily="Georgia" FontSize="22" FontWeight="Black" Foreground="White"
                       VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
            <TextBlock Grid.Column="1" Text="SIMULATION · SCORE REPORT" FontSize="12" FontWeight="Bold"
                       CharacterSpacing="120" Foreground="White" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
            <Button x:Name="DoneButton" Grid.Column="2" Click="OnDoneClick" FontWeight="SemiBold"
                    Padding="16,6" VerticalAlignment="Center">
                <Button.Resources>
                    <ResourceDictionary>
                        <SolidColorBrush x:Key="ButtonBackground" Color="White" />
                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#E6EEF5" />
                        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#CCD9E6" />
                        <SolidColorBrush x:Key="ButtonForeground" Color="#0E2B45" />
                        <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#0E2B45" />
                        <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#0E2B45" />
                        <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
                        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
                    </ResourceDictionary>
                </Button.Resources>
            </Button>
        </Grid>

        <ScrollViewer x:Name="Scroller" Grid.Row="1">
            <StackPanel x:Name="ContentPanel" Spacing="22" Margin="30" MaxWidth="980" HorizontalAlignment="Stretch">
                <StackPanel Spacing="7">
                    <TextBlock x:Name="HeadingText" FontSize="32" FontWeight="Bold" Foreground="{ThemeResource NavyBrush}"
                               TextWrapping="Wrap" AutomationProperties.HeadingLevel="Level1" />
                    <TextBlock x:Name="SubtitleText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    <InfoBar x:Name="EstimateInfo" Severity="Warning" IsOpen="True" IsClosable="False" Margin="0,3,0,0" />
                </StackPanel>

                <Grid x:Name="ScoreCardsGrid" ColumnSpacing="14" RowSpacing="14" />

                <Border x:Name="WritingCard" Style="{StaticResource CardStyle}" Visibility="Collapsed">
                    <StackPanel Spacing="6">
                        <TextBlock x:Name="WritingTitle" Style="{StaticResource SubtitleTextBlockStyle}" AutomationProperties.HeadingLevel="Level2" />
                        <TextBlock x:Name="WritingText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                                   IsTextSelectionEnabled="True" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel x:Name="SectionsPanel" Spacing="14">
                        <TextBlock Text="Section performance" Style="{StaticResource SubtitleTextBlockStyle}" AutomationProperties.HeadingLevel="Level2" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel x:Name="ReviewPanel" Spacing="14">
                        <TextBlock Text="Review answers" Style="{StaticResource SubtitleTextBlockStyle}" AutomationProperties.HeadingLevel="Level2" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8EF;" FontSize="16" Foreground="{ThemeResource NavyBrush}" />
                            <TextBlock x:Name="MethodologyTitle" Style="{StaticResource BodyStrongTextBlockStyle}"
                                       Foreground="{ThemeResource NavyBrush}" AutomationProperties.HeadingLevel="Level2" />
                        </StackPanel>
                        <TextBlock x:Name="MethodologyScores" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        <TextBlock x:Name="MethodologyWriting" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
